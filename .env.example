# 3. NEVER commit real API keys, service account files, or private keys to Git!
# =============================================================================

# Firebase Client Web Configuration (from Firebase Console -> Project Settings -> General -> Web Apps)
VITE_FIREBASE_API_KEY=AIzaSyA_EXAMPLE_PLACEHOLDER_KEY
VITE_FIREBASE_AUTH_DOMAIN=sjec-aqms-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://sjec-aqms-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=sjec-aqms-project
VITE_FIREBASE_STORAGE_BUCKET=sjec-aqms-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# IoT Telemetry Ingestion Secret (Included by ESP32 in X-Device-Token Header)
VITE_DEVICE_INGESTION_SECRET=sjec_aqms_sec_9f48a12e5c89304b

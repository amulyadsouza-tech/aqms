rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Institutional branding assets & college logos
    match /branding/{fileName} {
      // Allow public read so the public AQMS dashboard can display the college logo
      allow read: if true;
      
      // Allow write strictly to authenticated administrators with file type and size restrictions
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024 // 2MB max
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Default fallback deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

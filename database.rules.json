{
  "rules": {
    "admins": {
      "$uid": {
        ".read": false,
        ".write": false
      }
    },
    "config": {
      "branding": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      },
      "sensors": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      },
      "aqi": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      },
      "site": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      },
      "activeDeviceId": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },
    "devices": {
      "$deviceId": {
        "metadata": {
          ".read": true,
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
        },
        "status": {
          ".read": true,
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
        },
        "latest": {
          ".read": true,
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
          ".validate": "newData.hasChildren(['deviceId', 'timestamp']) && newData.child('deviceId').val() == $deviceId"
        },
        "history": {
          ".read": true,
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
          ".indexOn": ["timestamp"],
          "$recordId": {
            ".validate": "newData.hasChildren(['deviceId', 'timestamp']) && newData.child('deviceId').val() == $deviceId"
          }
        },
        "private": {
          ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
        }
      }
    },
    "public": {
      "dashboard": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    }
  }
}
